# M 平台环境变量示例 —— 复制为 .env 后把每个值换成你自己的随机长串
# 生成建议：python -c "import secrets;print(secrets.token_urlsafe(32))"

# ---- 数据库 ----
POSTGRES_PASSWORD=change-me-postgres

# ---- 观测（可选，留空则不上报 LangSmith）----
LANGSMITH_API_KEY=

# ---- 内部通道密钥（五级隔离，各生成各的）----
SANDBOX_TOKEN=change-me-sandbox
WEBHOOK_TOKEN=change-me-webhook
CODEBUDDY_PROXY_TOKEN=change-me-proxy-cb
VISION_PROXY_TOKEN=change-me-proxy-vision
RAG_PROXY_TOKEN=change-me-proxy-rag
M_GUARD_KEY=change-me-guard-comm

# ---- langgraph 认证模式（保持默认即可）----
# langgraph 原生 API 鉴权的 AuthConfig JSON（必填！缺了原生 8000 口裸奔，只靠 office 门）
LANGGRAPH_AUTH={"path": "/deps/outer-workspace/src/auth.py:auth"}

# ---- CodeBuddy 代理层上游（可选：不配则代理门返回未配置）----
CODEBUDDY_BASE_URL=
CODEBUDDY_API_KEY=
CODEBUDDY_MODEL=
